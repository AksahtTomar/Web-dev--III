{
  "info": {
    "name": "Student Management API",
    "description": "CRUD endpoints for the Student Management REST API assignment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" }
  ],
  "item": [
    {
      "name": "Get All Students",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/students"
      }
    },
    {
      "name": "Get Student By Id",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/students/1"
      }
    },
    {
      "name": "Create Student",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Sneha\",\n  \"course\": \"BSc\",\n  \"age\": 20\n}"
        },
        "url": "{{baseUrl}}/students"
      }
    },
    {
      "name": "Update Student",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"age\": 22\n}"
        },
        "url": "{{baseUrl}}/students/1"
      }
    },
    {
      "name": "Delete Student",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/students/2"
      }
    }
  ]
}
